# ═══ CLIENT (public, injecté au build — préfixe VITE_ obligatoire) ═══
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...
VITE_REVENUECAT_PUBLIC_KEY=appl_xxxx
VITE_MAPBOX_TOKEN=pk.eyJ1...
VITE_POSTHOG_KEY=phc_xxxx
VITE_SENTRY_DSN=

# ═══ SERVEUR (secrets — Vercel env + supabase secrets set, JAMAIS commités) ═══
# SUPABASE_SERVICE_ROLE_KEY=
# REVENUECAT_WEBHOOK_SECRET=
# BREVO_API_KEY=
# APP_URL=https://furrix.fr

# Web et applications iOS/Android : les circuits de paiement restent à finaliser.
# Aucun secret serveur dans une variable VITE_.

# ═══ ENTRÉE DE L'APPLICATION ═══
# Vide ou auth = connexion puis accueil Plein air.
# mvp / legacy = anciens prototypes, uniquement en développement ; production = nouveau parcours.
# VITE_FURRIX_APP=mvp
# platform-check = banc technique web/mobile (npm run dev:platform).
# Retours Auth à autoriser avant recette : voir docs/Architecture_Web_Mobile.md.

# ═══ NOUVEAU PARCOURS AUTH ═══
# npm run dev:auth / npm run build:auth ; même nouveau parcours que l'entrée par défaut.
# Activer uniquement après validation des textes, publication de leurs URL et migration des déclarations.
VITE_REGISTRATION_ENABLED=false
VITE_TERMS_URL=
VITE_TERMS_VERSION=
VITE_PRIVACY_URL=
VITE_PRIVACY_VERSION=
